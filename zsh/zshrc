# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Load zsh options, keybindings, and completion
[[ -f /usr/share/omarchy-zsh/shell/zoptions ]] && source /usr/share/omarchy-zsh/shell/zoptions

# Load shared shell configuration (aliases, functions, environment, tool init)
[[ -f /usr/share/omarchy-zsh/shell/all ]] && source /usr/share/omarchy-zsh/shell/all

# Add your own customizations below
#
# Make an alias for invoking commands you use constantly
# alias p='python'
# alias cx="claude --permission-mode=plan --allow-dangerously-skip-permissions"

# Put ~/.local/bin on PATH (was in ~/.zshrc before omarchy-setup-zsh replaced it)
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

# Gray suggestions from history; → accepts
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# CTRL + U deletes only before the cursor, like bash and macOS (zsh defaults to the whole line)
bindkey '^U' backward-kill-line

# CTRL + Backspace deletes the previous word (terminals send ^H, which zsh binds to deleting one character)
bindkey '^H' backward-kill-word

# CTRL + Delete deletes the next word (CTRL + SHIFT + Backspace sends it too, see hypr/line-editing.lua)
bindkey '^[[3;5~' kill-word

# mosh into the Mac (Host mac in ~/.ssh/config, over Tailscale).
# mosh-server lives in Homebrew's folder, which a non-interactive SSH login doesn't have on PATH.
alias moshmac='mosh --server=/opt/homebrew/bin/mosh-server mac'
