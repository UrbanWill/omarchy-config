# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Load zsh options, keybindings, and completion
[[ -f /usr/share/omarchy-zsh/shell/zoptions ]] && source /usr/share/omarchy-zsh/shell/zoptions

# Load shared shell configuration (aliases, functions, environment, tool init)
[[ -f /usr/share/omarchy-zsh/shell/all ]] && source /usr/share/omarchy-zsh/shell/all

# Add your own customizations below
#
# Make an alias for invoking commands you use constantly
# alias p='python'
# alias cx="claude --permission-mode=plan --allow-dangerously-skip-permissions"

# Put ~/.local/bin on PATH (was in ~/.zshrc before omarchy-setup-zsh replaced it)
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

# Suggestions from history; → accepts
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# The default suggestion color (palette 8) is too dim on most themes. Mix 60% of the
# theme's foreground into its background instead; new shells pick up theme changes.
() {
  setopt local_options extended_glob
  local colors=~/.local/state/omarchy/current/theme/colors.toml bg fg out i
  [[ -r $colors ]] || return
  bg=${${(M)${(f)"$(<$colors)"}:#background = *}#*\#}; bg=${bg%\"}
  fg=${${(M)${(f)"$(<$colors)"}:#foreground = *}#*\#}; fg=${fg%\"}
  [[ $bg == [[:xdigit:]](#c6) && $fg == [[:xdigit:]](#c6) ]] || return
  for i in 1 3 5; do
    out+=${(l:2::0:)$(( [##16] (16#${bg[i,i+1]} * 4 + 16#${fg[i,i+1]} * 6) / 10 ))}
  done
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#${(L)out}"
}

# Line-editing keys (CTRL + U, CTRL + Backspace, CTRL + Delete, redo), shared with the Mac mirror
source ~/.config/zsh/keys.zsh

# mosh into the Mac (Host mac in ~/.ssh/config, over Tailscale).
# mosh-server lives in Homebrew's folder, which a non-interactive SSH login doesn't have on PATH.
alias moshmac='mosh --server=/opt/homebrew/bin/mosh-server mac'

# Open the T3 Code desktop app on this machine's screen, also from an SSH session.
# SSH logins don't get HYPRLAND_INSTANCE_SIGNATURE, so take the newest running instance.
# `command ls` skips the eza alias, whose -t means something else.
t3gui() {
  HYPRLAND_INSTANCE_SIGNATURE=$(command ls -t "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" | head -1) \
    hyprctl dispatch "hl.dsp.exec_cmd(\"$HOME/.local/share/t3code/T3-Code.AppImage\")"
}

# Per-machine additions, not tracked in git.
if [[ -f ~/.config/zsh/local.zsh ]]; then source ~/.config/zsh/local.zsh; fi

# devmac: mosh into the Mac with this machine's tmux, zsh and Neovim (github.com/UrbanWill/mac-dotfiles-mirror-omarchy).
# Loaded after local.zsh so an older devmac defined there can't shadow it.
[[ -f ~/Projects/mac-dotfiles-mirror-omarchy/omarchy/devmac.zsh ]] && source ~/Projects/mac-dotfiles-mirror-omarchy/omarchy/devmac.zsh
